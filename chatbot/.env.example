# Copy to .env for local development (already git-ignored by the repo's root .gitignore).
# In production, set these in the Vercel project settings instead.

# Required. Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default is gemini-3.8-flash (fast and low cost, a good fit for site chat).
# Use any model code listed in Google AI Studio.
# CHATBOT_MODEL=gemini-3.8-flash

# Optional but recommended in production: only these sites may call the API.
# Comma-separated, no trailing slash.
# ALLOWED_ORIGINS=https://anahum-web-new.vercel.app

# Local testing only: return canned replies and skip the model call.
# CHATBOT_MOCK=1
